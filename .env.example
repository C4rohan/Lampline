# Optional settings for Lampline. Copy to .env (git-ignored, never commit it), or
# skip this file and set everything on the engine's Integrations page instead.
# scripts/docker-up.sh and scripts/engine-up.sh add the keys they need themselves.

# --- the model (pick one provider; the Integrations page lists them all) -----
# VPE_LLM=anthropic            # anthropic | openai | google | vertex | azure | bedrock | groq | mistral
#                              # | deepseek | xai | together | fireworks | openrouter | cerebras | nvidia
#                              # | qwen | sambanova | nebius | novita | ollama
# VPE_LLM_MODEL=               # empty: the provider's default model
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=              # with VPE_LLM_BASE_URL for any OpenAI-compatible endpoint
# GEMINI_API_KEY=
# GOOGLE_CLOUD_PROJECT=        # Vertex AI (uses this computer's Google credentials, or a pasted key)
# AZURE_OPENAI_API_KEY=  AZURE_OPENAI_ENDPOINT=
# AWS_ACCESS_KEY_ID=  AWS_SECRET_ACCESS_KEY=  AWS_REGION=us-east-1      # Bedrock
# GROQ_API_KEY=  MISTRAL_API_KEY=  DEEPSEEK_API_KEY=  XAI_API_KEY=  OPENROUTER_API_KEY=
# TOGETHER_API_KEY=  FIREWORKS_API_KEY=  CEREBRAS_API_KEY=  NVIDIA_API_KEY=
# DASHSCOPE_API_KEY=  SAMBANOVA_API_KEY=  NEBIUS_API_KEY=  NOVITA_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- speech (only for voice calls) ------------------------------------------
# DEEPGRAM_API_KEY=            # listening and speaking
# FISH_API_KEY=                # Fish Audio listening and/or speaking
# VPE_TTS_VOICE=aura-2-helena-en
# Or free Whisper and Kokoro on this computer: Integrations → Download models.
# VPE_STT=moonshine            # free streaming speech to text on this computer (English)
# VPE_MOONSHINE_MODEL=small-streaming   # or tiny-streaming: fastest
# VPE_TURN_DETECTION=smart     # smart (listens to how the caller sounds) | pause (fixed silence)
# VPE_TURN_PAUSE=              # seconds: smart's longest wait (3), or the fixed pause (0.8)

# --- phone calls --------------------------------------------------------------
# TWILIO_AUTH_TOKEN=           # Twilio numbers (scripts/engine-up.sh --tunnel)
# TELNYX_PUBLIC_KEY=  TELNYX_API_KEY=          # Telnyx numbers
# JAMBONZ_WEBHOOK_SECRET=      # any SIP trunk, PBX or SBC through jambonz
# VPE_JAMBONZ_SAMPLE_RATE=8000 # 16000 for HD voice when the trunk carries wideband audio
# JAMBONZ_API_URL=https://api.jambonz.cloud   JAMBONZ_ACCOUNT_SID=  JAMBONZ_API_KEY=
# JAMBONZ_APPLICATION_SID=  JAMBONZ_FROM_NUMBER=   # outbound calls over SIP through jambonz
# Synthetic test data only: don't route real customer calls (or any PHI/PII) to a laptop.

# --- sharing it: named keys are made on the Team page; see docs/HTTPS.md ------
# VPE_REMOTE_EDITING=off       # on: keys may save agents, data and knowledge through an HTTPS proxy

# --- call history (the Calls page; kept on this computer) -------------------
# VPE_CALL_HISTORY=on  VPE_CALL_HISTORY_DAYS=30  VPE_CALL_RECORDINGS=off

# --- messaging, Google and triggers (also on the Integrations page) ---------
# TELEGRAM_BOT_TOKEN=
# WHATSAPP_ACCESS_TOKEN=  WHATSAPP_PHONE_NUMBER_ID=  WHATSAPP_APP_SECRET=  WHATSAPP_VERIFY_TOKEN=
# VPE_EMAIL_PROVIDER=smtp   VPE_EMAIL_ADDRESS=  VPE_EMAIL_PASSWORD=  VPE_SMTP_HOST=  VPE_IMAP_HOST=
# GOOGLE_CLIENT_ID=  GOOGLE_CLIENT_SECRET=      # then "Connect Google account" saves the refresh token
# VPE_TIMEZONE=America/New_York
# VPE_OUTBOUND=off             # on: schedules and the API trigger may call or message people
# TWILIO_ACCOUNT_SID=  TWILIO_FROM_NUMBER=      # outbound calls
# VPE_SECRET_SCHEDULING_KEY=   # a tool secret, used in a tool as {{secrets.SCHEDULING_KEY}}

# --- workspace ----------------------------------------------------------------
# BRAND_NAME="Lampline"        # the name shown in the app
